# npm (prod Dockerfile / local): tolerate peer-dep conflicts
legacy-peer-deps=true

# pnpm (staging Dockerfile): equivalent peer handling + flat node_modules
# node-linker=hoisted -> npm-style flat tree, safest for Next standalone,
# next start, and Prisma client resolution (no symlink edge cases).
auto-install-peers=true
strict-peer-dependencies=false
node-linker=hoisted
