// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  /// Nombre de usuario, para entrar sin correo.
  ///
  /// En PEDIDO la gente entra con `yasmani`, `claudia.hab`, `rene`… y muchos no
  /// tienen correo. Obligarles a uno para poder entrar aquí sería inventarles
  /// una dirección que no leen y una forma de identificarse que no reconocen.
  ///
  /// El correo sigue siendo obligatorio porque better-auth lo usa como clave de
  /// la cuenta; a quien no tenga se le pone uno interno (`usuario@procovar.local`)
  /// que no recibe nada y que nadie necesita saberse.
  username      String?        @unique
  emailVerified Boolean
  image         String?
  isSystemAdmin Boolean        @default(false)
  phone         String?
  nationality   String?
  address       String?
  passportId    String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  subscriptions Subscription[]

  @@map("user")
}

model Session {
  id                   String    @id @default(cuid())
  userId               String
  token                String    @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  clientId             String?
  revokedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberRoles    MemberRole[]

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id                 String       @id @default(cuid())
  organizationId     String
  email              String
  role               String
  status             String
  tokenHash          String?
  inviterId          String
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  acceptedAt         DateTime?
  roleId             String?
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter            User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// ── Subscription Plans ──────────────────────────────────

model Plan {
  id            String         @id @default(cuid())
  key           String         @unique /// Stable identifier: "basic", "pro", "pro_plus"
  name          String /// Display name: "Basic", "Pro", "Pro Plus"
  description   String?
  priceMonthly  Decimal        @default(0) @db.Decimal(10, 2) /// Monthly price in USD
  priceYearly   Decimal        @default(0) @db.Decimal(10, 2) /// Yearly price in USD
  features      Json           @default("{}") /// Flexible feature flags & limits (JSON)
  sortOrder     Int            @default(0) /// Display ordering
  isActive      Boolean        @default(true) /// Soft-disable without deleting
  icon          String?
  color         String?
  popular       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subscriptions Subscription[]

  @@map("plan")
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  billingCycle       BillingCycle       @default(MONTHLY)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime
  cancelledAt        DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, status])
  @@map("subscription")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

// ── Identity Hub: Service-to-Service & API keys ──────────

/// External application / microservice that delegates auth to qb-auth.
/// `clientSecretHash` is currently unused (per-client signing keys are derived
/// from SERVICE_AUTH_SECRET via HMAC). Reserved for future per-client static
/// secrets (e.g. webhook-style signing).
model ClientApp {
  id                  String   @id @default(cuid())
  clientId            String   @unique /// Stable identifier (e.g. "qb-booking")
  name                String
  description         String?
  clientSecretHash    String? /// argon2id hash, optional
  signingKeyVersion   Int      @default(1) /// bump to rotate the derived signing key
  allowedCallbackUrls String[] @default([]) /// exact origin+path match
  allowedDomains      String[] @default([]) /// host (or parent host) for returnTo
  scopes              String[] @default([]) /// e.g. ['callback:create','session:verify']
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  apiKeys             ApiKey[]

  @@map("client_app")
}

/// Owner custom domains that qb-auth trusts as SSO callback hosts.
/// Manually created + verified + activated by an admin for now; the future
/// per-property UI writes to this same table. The validation gate is `active`.
model TenantDomain {
  id         String   @id @default(cuid())
  host       String   @unique /// host only, no scheme/path, lowercase (e.g. "dozzze-romeo.com")
  clientId   String /// the ClientApp.clientId that serves this domain (e.g. "qb-sites")
  propertyId String? /// optional link to a property (future)
  verified   Boolean  @default(false) /// admin sets after confirming ownership
  active     Boolean  @default(false) /// admin sets; ONLY active domains pass validation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId])
  @@map("tenant_domain")
}

/// API key for human/script access. The plaintext key is shown once on
/// creation and then only its argon2id hash is stored.
model ApiKey {
  id          String     @id @default(cuid())
  prefix      String     @unique /// 8 hex chars, public lookup
  hash        String /// argon2id of the secret part
  name        String
  scopes      String[]   @default([])
  clientAppId String?
  userId      String?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  clientApp   ClientApp? @relation(fields: [clientAppId], references: [id], onDelete: SetNull)

  @@index([clientAppId])
  @@index([userId])
  @@map("api_key")
}

/// Audit trail for security-relevant actions.
model AuditLog {
  id        String   @id @default(cuid())
  action    String /// e.g. "callback.create", "auth.code.exchange", "session.revoke"
  resource  String?
  clientId  String?
  userId    String?
  ip        String?
  ua        String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_log")
}

/// Asymmetric signing keypair used for RS256 JWTs and exposed via JWKS.
/// Multiple non-revoked keys may exist simultaneously (rotation grace).
/// The most recently created non-revoked, non-expired key is used to sign.
model JwksKey {
  id         String    @id @default(cuid())
  kid        String    @unique /// JWKS key id (also kept in JWT header)
  alg        String    @default("RS256")
  publicPem  String    @db.Text
  privatePem String    @db.Text /// stored encrypted-at-rest only by Postgres TDE; access via env-only
  active     Boolean   @default(true) /// false = do not sign with this key (still verified)
  revokedAt  DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([active, revokedAt])
  @@map("jwks_key")
}

/// Runtime key-value store for system configuration (e.g. service URLs).
/// Values here override env-var fallbacks so domain changes don't require redeployment.
model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

// ── RBAC: Permissions / Roles ────────────────────────────

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  resource        String
  action          String
  service         String
  group           String
  label           Json
  description     Json?
  isDeprecated    Boolean          @default(false)
  rolePermissions RolePermission[]

  @@map("permission")
}

/// Catálogo de roles, ÚNICO para todo Procovar.
///
/// NO cuelga de la organización a propósito. La organización es la SUCURSAL, y
/// los roles son los mismos en las ocho: Super Admin, Administrador, Supervisor,
/// Gestor, Operador. Colgarlo de cada una obligaría a crear "Operador" ocho
/// veces y, el día que cambie lo que puede hacer, a tocarlas todas — o quedarían
/// distintas sin que nadie lo notara.
///
/// Lo que cambia de una persona a otra no es el rol: es EN QUÉ SUCURSAL lo
/// tiene, y eso ya lo dice su `Member`. El rol se le asigna a la PERSONA
/// (`MemberRole`), y lo editan el Super Admin o el Administrador.
model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  color       String?
  icon        String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  memberRoles MemberRole[]

  @@map("role")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

/// Esta persona tiene este rol.
///
/// El ALCANCE no se guarda aquí: sale del `Member`, que ya pertenece a una
/// sucursal. "Yasmani es Operador en Camagüey" es esta fila más su miembro.
/// Si mañana lleva también Holguín, es otro miembro con el mismo rol — sin
/// duplicar el rol.
///
/// Se quitó el alcance por PROPIEDAD (`scopeAllProperties`, `propertyIds`): era
/// del negocio de alojamientos. En Procovar no hay propiedades.
model MemberRole {
  id       String @id @default(cuid())
  memberId String
  roleId   String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role     Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([memberId, roleId])
  @@map("member_role")
}

/// Evidence that a customer accepted the published legal terms before paying.
/// Kept in qb-auth (the identity + checkout owner) and referenced by invoice /
/// reservation id — those live in qb-back, so they are opaque strings here,
/// never foreign keys (same posture as every other qb-back id in this schema).
model TermsAcceptance {
  id            String   @id @default(cuid())
  authUserId    String
  invoiceId     String?
  reservationId String?
  /// Version of the legal corpus accepted (COMPANY.termsVersion).
  termsVersion  String
  /// Slugs of the documents shown/accepted, e.g. ["condiciones","cancelaciones"].
  documents     String[]
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([authUserId])
  @@index([invoiceId])
  @@map("terms_acceptances")
}
