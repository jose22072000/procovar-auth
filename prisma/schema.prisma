// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  isSystemAdmin Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  auditLogs     AuditLog[]
  userRoles     UserRole[]

  @@map("user")
}

// Auditoría central: qué hace cada usuario y en QUÉ client (aplicación) lo hace.
// La alimentan (a) los eventos de auth de este servicio y (b) las apps conectadas
// vía POST /api/audit (con x-api-key). No hay FK a organización para no acoplar.
model AuditLog {
  id             String   @id @default(cuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?                 // organización activa (si aplica)
  clientId       String?                 // qué app: pedido | delivery | analitics | auth ...
  action         String                  // "sign-in", "sign-out", "order.create", ...
  resource       String?                 // sobre qué objeto (id/ruta), opcional
  status         String   @default("success") // success | failure
  ipAddress      String?
  userAgent      String?
  metadata       Json?                   // datos extra libres
  createdAt      DateTime @default(now())

  @@index([userId])
  @@index([clientId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

model Session {
  id                   String   @id @default(cuid())
  userId               String
  token                String   @unique
  expiresAt            DateTime
  ipAddress            String?
  userAgent            String?
  activeOrganizationId String?
  clientId             String?
  revokedAt            DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     Member[]
  invitations Invitation[]
  roles       Role[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String
  tokenHash      String?
  inviterId      String
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@map("invitation")
}

// RBAC customizable: un rol es un conjunto de permisos (claves resource.action).
// Puede ser global (organizationId null) o propio de una organización/sucursal.
model Role {
  id             String        @id @default(cuid())
  name           String
  slug           String
  description    String?
  organizationId String? // null = rol global (disponible en todas las orgs)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    String[]      @default([]) // ["users.read", "delivery.routes.manage", ...]
  isSystem       Boolean       @default(false) // roles base que no se pueden borrar
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userRoles      UserRole[]

  @@unique([organizationId, slug])
  @@map("role")
}

// Asignación de roles a usuarios (muchos-a-muchos). Un usuario puede tener VARIOS
// roles; sus permisos efectivos son la UNIÓN de los permisos de todos sus roles.
model UserRole {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId         String
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organizationId String? // contexto (sucursal) de la asignación, opcional
  createdAt      DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@map("user_role")
}
